# Local setup only. Never put production credentials in this repository.
# The foundation renders without a database. Set this before applying migrations.
DATABASE_URL=
# Replace with the verified canonical origin when deploying elsewhere.
SITE_URL=https://undery.link
# Used during the build, visible through /api/health.
BUILD_COMMIT=local
# Optional DNS design examples: 1 enables them only in next dev.
# Production always ignores this flag. Never use examples as DB seed data.
CODING_PREVIEW=0

# Create a GitHub OAuth App; never commit its client secret.
# Callback: https://undery.link/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Verified numeric GitHub user ID for Undery33; a login/name is not sufficient.
ADMIN_GITHUB_ID=127064386

# Absolute persistent path outside the checkout/releases. No public static alias.
# Host deployment uses StateDirectory=undery-media with this path.
MEDIA_DIRECTORY=/var/lib/undery-media
